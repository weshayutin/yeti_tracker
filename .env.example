# contact aussie or tackle or mysql readonly info
# Required: MySQL RDS hostname
DB_HOST=foo

# Required: Database credentials
DB_USER=changeme
DB_PASSWORD=changeme

# Optional: MySQL port (default: 3306)
DB_PORT=3306

# Optional: Database names (defaults shown)
DB_NAME_NORTH=f3denver
DB_NAME_SOUTH=f3denversouth

# Optional: Default date range for queries (format: YYYY-MM-DD)
DEFAULT_START_DATE=2025-12-21
DEFAULT_END_DATE=2026-03-20

# Optional: HTTP server port (default: 8080)
SERVER_PORT=8080
